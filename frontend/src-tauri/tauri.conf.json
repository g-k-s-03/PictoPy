{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "app"],
    "createUpdaterArtifacts": false,
    "linux": {
      "deb": {
        "postInstallScript": "./postinstall.sh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../backend/dist/": "resources/backend",
      "../../sync-microservice/dist/": "resources/sync-microservice"
    },
    "macOS": {
      "signingIdentity": "-",
      "entitlements": "./Entitlements.plist"
    }
  },
  "productName": "PictoPy",
  "identifier": "org.aossie.pictopy",
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": true
    },
  },
  "app": {
    "windows": [
      {
        "title": "PictoPy",
        "width": 800,
        "height": 600,
        "minWidth": 1280,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "maximized": false,
        "devtools": true
      }
    ],
    "security": {
      "assetProtocol": {
        "scope": [
          "$HOME/.local/share/PictoPy/thumbnails/**",
          "**",
          "$HOME/Library/Application Support/PictoPy/thumbnails/**"
        ],
        "enable": true
      },
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; media-src 'self' blob: data:; connect-src 'self' ipc: http://ipc.localhost http://localhost:52123 ws://localhost:52123 http://localhost:52124 ws://localhost:52124"
    }
  }
}
